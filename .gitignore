# Rust
/target/
**/target/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# ML artifacts (large binaries are versioned elsewhere); the one exception is the
# small committed parity fixture consumed by cargo test in CI.
*.onnx
!crates/ml/tests/fixtures/*.onnx
!ml/registry/**/*.onnx

# Source checkout and build tree of the static onnxruntime build (lab/provisioning/build-onnxruntime-static.*)
/onnxruntime/

# Vagrant (per-machine state, box images, generated SSH keys)
.vagrant/

# Editors / OS
.DS_Store
.idea/
.vscode/
*.egg-info/
/baselines/
