<Sysmon schemaversion="4.90">
  <!-- Lab capture for ADR-0026 (#715). In Sysmon, an event type with onmatch="exclude" and no
       rule logs EVERYTHING, and one with onmatch="include" and no rule logs NOTHING.
       Events 4, 16 and 255 (service state, configuration change, error) are generated by
       Sysmon itself and are not filterable. -->
  <EventFiltering>
    <!-- Event 2: file creation time changed -->
    <FileCreateTime onmatch="exclude" />
    <!-- Event 9: raw disk read -->
    <RawAccessRead onmatch="exclude" />
    <!-- Event 15: alternate data stream created (Zone.Identifier included) -->
    <FileCreateStreamHash onmatch="exclude" />
    <!-- Events 17 and 18: named pipe created / connected -->
    <PipeEvent onmatch="exclude" />
    <!-- Event 23 ARCHIVES every file it logs (a copy of the deleted file goes to the Sysmon
         archive directory), so it is limited to one lab folder: delete a file under
         C:\Lab\SysmonDeleteTest\ to produce a sample. Event 26 below logs deletions of
         every file WITHOUT archiving them. -->
    <FileDelete onmatch="include">
      <TargetFilename condition="begin with">C:\Lab\SysmonDeleteTest\</TargetFilename>
    </FileDelete>
    <!-- Event 25: process image tampering (hollowing / herpaderping) -->
    <ProcessTampering onmatch="exclude" />
    <!-- Event 26: file delete detected (no archive) -->
    <FileDeleteDetected onmatch="exclude" />
  </EventFiltering>
</Sysmon>
