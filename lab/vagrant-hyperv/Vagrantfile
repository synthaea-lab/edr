# lab/vagrant-hyperv — Hyper-V harness (Windows hosts)
#
# Sibling of ../vagrant (QEMU on Apple Silicon). Same machine matrix
# (../MATRIX.md), same provider-neutral provisioning scripts (per-family:
# ../provisioning/linux-toolchain.sh for apt/dnf, arch-toolchain.sh for
# pacman). x86_64 rows only — see README.md for the box situation.
#
#   # from an ELEVATED PowerShell (the Hyper-V provider requires it):
#   $env:VAGRANT_HYPERV_SWITCH = "Default Switch"
#   vagrant up ubuntu2204 --provider hyperv
#   vagrant rsync ubuntu2204        # re-push the repo after host-side edits
#   vagrant ssh ubuntu2204
#   vagrant destroy -f ubuntu2204   # rollback = destroy + up

# jtarpley/fedora41_base is a 40 GB LVM disk split into many small logical
# volumes: / has ~6 GB free after the LLVM packages and /home under 1 GB, so
# rustup ("No space left on device") and a release build do not fit there, while
# /var has ~9 GB free. Redirect the per-user toolchain to /var before the
# toolchain script runs; build with CARGO_TARGET_DIR=/var/synthaea/target.
FEDORA_PREP = <<~'SH'
  set -eu
  mkdir -p /var/synthaea/cargo /var/synthaea/rustup /var/synthaea/target
  chown -R vagrant:vagrant /var/synthaea
  for d in cargo rustup; do
    if [ ! -L /home/vagrant/.$d ]; then rm -rf /home/vagrant/.$d; fi
    ln -sfn /var/synthaea/$d /home/vagrant/.$d
    chown -h vagrant:vagrant /home/vagrant/.$d
  done
  echo "export CARGO_TARGET_DIR=/var/synthaea/target" >> /etc/profile.d/synthaea-cargo.sh
SH

# name => [box, kernel it proves]. Hyper-V box availability is thin: generic/*
# only covers 5.15 and 6.1, so the 6.8 and 6.12 rows use community boxes that
# ship a Hyper-V provider, each with manual fix-ups (README.md "Community
# boxes"). The SMB /vagrant prompt that got boxen/ubuntu-24.04 rejected is
# neutralised below (rsync only).
LINUX_MACHINES = {
  "ubuntu2204" => { box: "generic/ubuntu2204", primary: true }, # 5.15 — oldest LTS
  "debian12"   => { box: "generic/debian12" },                  # 6.1  — Debian stable
  "ubuntu2404" => { box: "jtarpley/ubuntu2404_base" },          # 6.8  — current LTS
  "debian13"   => { box: "shekeriev/debian-13" },               # 6.12 — Debian trixie
  "arch"       => { box: "generic/arch", provision: "../provisioning/arch-toolchain.sh" }, # rolling — #124
  # RPM family, SELinux Enforcing out of the box — deliberately left that way
  # (no `setenforce 0` in provisioning): this is the row that runs the eBPF/LSM/
  # audit sensors under a real RHEL-family security policy. The box ships the
  # Fedora 41 kernel line (6.11); check `uname -r` after `up`, a `dnf upgrade`
  # moves it. `linux-toolchain.sh` already has the dnf branch.
  "fedora41"   => { box: "jtarpley/fedora41_base", prep: FEDORA_PREP }, # 6.11 GA, 6.17 after updates — Fedora, SELinux enforcing
}.freeze

# Makes any box able to build the toolchain and the agent without OOM kills,
# whatever it ships with (see the memory note in the provider block). Runs as
# root before the toolchain script, idempotent on re-provision:
# - a 4 GB swapfile, skipped with a notice when / has under 8 GB free
#   (ubuntu2404's root is tight until the README's LVM fix-up);
# - swappiness 60, written to /proc directly because debian13 has no `sysctl`
#   binary (ubuntu2404 pins it to 0 in /etc/sysctl.conf, which disables swap
#   for anonymous memory in practice);
# - CARGO_BUILD_JOBS=2, so rustc/LLVM peaks stay within that budget.
BUILD_HOST_SETUP = <<~'SH'
  set -eu
  free_gb=$(df --output=avail -BG / | tail -1 | tr -dc 0-9)
  # Built under a temporary name and renamed once mkswap succeeded, so an
  # interrupted run never leaves a headerless /swapfile-synthaea behind. No
  # `mkswap -q`: util-linux 2.37 (ubuntu2204) does not have it.
  if [ ! -f /swapfile-synthaea ] && [ "$free_gb" -ge 8 ]; then
    rm -f /swapfile-synthaea.tmp
    fallocate -l 4G /swapfile-synthaea.tmp || dd if=/dev/zero of=/swapfile-synthaea.tmp bs=1M count=4096
    chmod 600 /swapfile-synthaea.tmp
    mkswap /swapfile-synthaea.tmp > /dev/null
    mv /swapfile-synthaea.tmp /swapfile-synthaea
  fi
  if [ -f /swapfile-synthaea ] && ! grep -q "^/swapfile-synthaea " /etc/fstab; then
    echo "/swapfile-synthaea none swap sw 0 0" >> /etc/fstab
  fi
  if [ -f /swapfile-synthaea ]; then
    swapon --show=NAME | grep -qx /swapfile-synthaea || swapon /swapfile-synthaea
  else
    echo "build-host-setup: only ${free_gb} GB free on /, no swapfile (re-run: vagrant provision --provision-with build-host-setup)"
  fi
  if [ -f /etc/sysctl.conf ]; then sed -i '/^vm.swappiness/d' /etc/sysctl.conf; fi
  echo "vm.swappiness = 60" > /etc/sysctl.d/90-synthaea.conf
  echo 60 > /proc/sys/vm/swappiness
  echo "export CARGO_BUILD_JOBS=2" > /etc/profile.d/synthaea-cargo.sh
SH

Vagrant.configure("2") do |config|
  # Force rsync for every synced folder — some boxes default /vagrant to an SMB
  # share, which prompts for Windows credentials on every `up`. We use only the
  # rsync /synthaea folder below.
  config.vm.allowed_synced_folder_types = ["rsync"]
  config.vm.synced_folder ".", "/vagrant", disabled: true

  # No native Hyper-V file sharing without SMB creds; rsync the repo root to
  # /synthaea (needs an rsync on the host — Git for Windows ships one, or
  # `winget install cwRsync`). Same contract as ../vagrant.
  config.vm.synced_folder "../..", "/synthaea", type: "rsync",
    rsync__exclude: [".git/", "target/", "old/", "ml/.venv/", "ml/datasets/"]

  config.vm.boot_timeout = 600
  config.ssh.insert_key = true

  LINUX_MACHINES.each do |name, opts|
    config.vm.define name, primary: opts[:primary], autostart: !!opts[:primary] do |m|
      m.vm.box      = opts[:box]
      m.vm.hostname = "synthaea-#{name}"

      m.vm.provider "hyperv" do |hv|
        hv.vmname                           = "synthaea-#{name}"
        hv.cpus                             = 4
        # Dynamic memory: maxmemory > memory makes vagrant-hyperv enable Hyper-V
        # Dynamic Memory with `memory` as the startup/minimum and `maxmemory` as
        # the ceiling. A static 4096 fails with 0x800705AA on a 16 GB host once a
        # browser/IDE is open. But the balloon rarely grows in practice: these
        # guests report a demand well under what they use, so a build thrashes
        # at the startup amount while the host has GBs free (seen on ubuntu2404
        # and debian13, rustc OOM-killed at 1 GB). Hence 2 GB at startup, the
        # least a `-j2` toolchain build survives on, plus the swap and job cap
        # from the BUILD_HOST_SETUP provisioner below.
        hv.memory                           = 2048
        hv.maxmemory                        = 4096
        hv.linked_clone                     = true
        hv.enable_virtualization_extensions = false
      end

      m.vm.provision "shell", name: "build-host-setup", inline: BUILD_HOST_SETUP
      m.vm.provision "shell", name: "prep", inline: opts[:prep] if opts[:prep]

      # Provider-neutral, shared by every harness. Debian/RPM machines use the
      # apt/dnf script; a machine on a different package manager (pacman,
      # apk) names its own companion script via `provision:`.
      m.vm.provision "shell", path: opts[:provision] || "../provisioning/linux-toolchain.sh", privileged: false
    end
  end
end
