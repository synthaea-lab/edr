# crates/correlator/src/engine.rs and crates/policy/src/lib.rs were committed with
# CRLF while the rest of the tree is LF. rustfmt run on Linux (CI, or the lab VMs)
# then rewrites those files whole just to flip line endings, burying the real diff.
# Pin *.rs to LF so formatting stays a content-only change regardless of the
# developer's core.autocrlf.
*.rs text eol=lf

# Shell scripts run inside Linux VMs and CI. With core.autocrlf=true on a Windows
# checkout they would otherwise get CRLF, and the lab harness rsyncs the working
# tree verbatim into the guest -- a lone `\r` then breaks `set -o pipefail` and
# every command. Force LF regardless of the developer's git config.
*.sh   text eol=lf
*.bash text eol=lf

# Windows-side scripts stay CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# ml/datasets baselines are hash-pinned (manifest.json's sample_sha256) against their
# on-disk bytes. Without this, Windows contributors on the Git-for-Windows default
# core.autocrlf=true get LF silently rewritten to CRLF on checkout, and every
# verify_manifest run fails with a hash mismatch that has nothing to do with content
# (issue #196, found reviewing #192).
ml/datasets/**/*.jsonl text eol=lf
ml/datasets/**/manifest.json text eol=lf

# lab/scenarios/*.yaml sidecars are content-hashed too: ADR-0009's
# ScenarioReplayResult.scenario_yaml_sha256 binds a model record to the exact
# on-disk bytes of the scenario it was replayed against, invalidating the binding
# on any mutation. Same hash-drift risk as ml/datasets above if a Windows
# contributor's core.autocrlf rewrites LF to CRLF on checkout.
lab/scenarios/*.yaml text eol=lf

# Rust/Python parity fixtures (CLAUDE.md "Parity seams"). Checked: both sides read
# these via json.loads/serde_json::from_str, which treat \r as insignificant
# whitespace outside strings, so CRLF here doesn't actually break a test the way
# it does for ml/datasets' sample_sha256 check above — but it's still the same
# diff-hygiene reason *.rs is pinned: a CRLF round-trip would rewrite every line
# of a fixture for no content reason. Pin for that, not for correctness.
ml/tests/fixtures/**/*.jsonl text eol=lf
crates/**/tests/fixtures/**/*.json text eol=lf
crates/**/tests/fixtures/**/*.jsonl text eol=lf
server/tests/fixtures/**/*.json text eol=lf

# ONNX model files are binary (protobuf). Not currently relying on an incorrect
# guess from Git's content-sniffing heuristic, just making it explicit.
*.onnx binary
