# Contributor: Synthaea Security <security@synthaea.io>
# Maintainer: Synthaea Security <security@synthaea.io>
pkgname=synthaea-agent
pkgver=0.1.0
pkgrel=0
pkgdesc="Synthaea EDR Agent - on-device eBPF detection and response"
url="https://github.com/synthaea-lab/edr"
# Static-musl build, same constraint as packaging/linux/build-deb.sh (the
# ONNX Runtime static-link flag discovery is written against that host).
arch="x86_64"
license="Apache-2.0"
# Fully static (musl, +crt-static): no runtime library dependency at all,
# same property the .deb build on Alpine proves (CI: linux-deb-portability.yml).
depends=""
makedepends="cargo rust-std findutils tar zstd curl python3 python3-dev py3-pip
	cmake clang llvm-dev binutils git bash elfutils-dev openssl-dev xz-dev
	xz-static zstd-dev"
install="$pkgname.pre-install $pkgname.post-install $pkgname.pre-deinstall $pkgname.post-deinstall"
subpackages=""
# cargo build needs crates.io + the onnxruntime source clone; abuild's
# default sandbox has no network.
options="net !check"

# Built directly from the monorepo checkout this APKBUILD ships in — not an
# upstream tarball (same reasoning as build-deb.sh/build-rpm.sh: these are
# packaging recipes for this repo, not a standalone release artifact).
builddir="$startdir/../../.."

build() {
	cd "$builddir"
	local target=x86_64-unknown-linux-musl

	if ! command -v bpf-linker >/dev/null 2>&1; then
		error "bpf-linker not found — run lab/provisioning/alpine-toolchain.sh first"
		return 1
	fi
	rustup target add "$target" 2>/dev/null || true

	local ort_lib_location="${ORT_LIB_LOCATION:-}"
	if [ -z "$ort_lib_location" ]; then
		msg "Building static ONNX Runtime from source (lab/provisioning/build-onnxruntime-static.sh)..."
		"$builddir/lab/provisioning/build-onnxruntime-static.sh"
		ort_lib_location="$builddir/onnxruntime/build/Linux/Release"
	fi

	local ort_flags
	ort_flags="$(bash "$builddir/lab/provisioning/ort-static-link-flags.sh")" \
		|| die "ort-static-link-flags.sh failed: ONNX Runtime cannot be linked statically"
	case "$ort_flags" in
		*"-l static="*) ;;
		*) die "ort-static-link-flags.sh produced no link flags" ;;
	esac

	export ORT_LIB_LOCATION="$ort_lib_location"
	export RUSTFLAGS="${ort_flags} -C target-feature=+crt-static"
	CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-2}" \
		CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_RUNNER=env \
		cargo build --locked --release --target "$target" \
		--no-default-features -p agent -p watchdog -p cli

	# The shipped artifacts: no public test signing key (ADR-0027).
	"$builddir/tools/assert-no-test-key.sh" \
		"target/$target/release/agent" \
		"target/$target/release/watchdog" \
		"target/$target/release/cli"
}

package() {
	cd "$builddir"
	local target=x86_64-unknown-linux-musl
	local bin="target/$target/release"

	install -D -m755 "$bin/agent" "$pkgdir/var/lib/synthaea/bootstrap/agent"
	install -D -m755 "$bin/watchdog" "$pkgdir/var/lib/synthaea/bootstrap/watchdog"
	install -D -m755 "$bin/cli" "$pkgdir/var/lib/synthaea/bootstrap/cli"

	install -D -m755 "$startdir/synthaea-agent.initd" \
		"$pkgdir/etc/init.d/synthaea-agent"

	# The same default-agent.toml template `cli config init` writes (#675's
	# .deb precedent): every control-plane field is a `# CHANGE ME`, but
	# offline_fallback = true lets the agent start and run on it as shipped.
	install -D -m644 "$builddir/crates/config/data/default-agent.toml" \
		"$pkgdir/etc/synthaea/agent.toml"

	install -d -m750 "$pkgdir/var/lib/synthaea/versions"
	install -d -m750 "$pkgdir/var/log/synthaea"

	# /usr is read-only while the service runs under its hardening (same
	# reasoning as the systemd unit's ProtectSystem=strict and the .deb
	# postinst's identical symlink), so this is created at package-install
	# time, not by the service itself.
	install -d "$pkgdir/usr/bin"
	ln -s /var/lib/synthaea/current/cli "$pkgdir/usr/bin/synthaea-ctl"
}

sha512sums="
"
