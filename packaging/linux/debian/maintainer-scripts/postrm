#!/bin/sh
set -e

case "$1" in
    purge)
        # Clean uninstall: remove all state. synthaea-ctl itself is a regular
        # package asset now (#897), not a symlink dpkg never knew about — it
        # already removed /usr/bin/synthaea-ctl before this script ran.
        rm -rf /var/lib/synthaea /var/log/synthaea /run/synthaea
        # Keep user for forensics (commented): deluser --system synthaea || true
        ;;
esac

#DEBHELPER#
exit 0
