Name:           synthaea-agent
Version:        0.1.0
Release:        1%{?dist}
Summary:        Synthaea EDR Agent - Endpoint detection and response

License:        Apache-2.0
URL:            https://github.com/synthaea-lab/edr
Source0:        synthaea-agent-%{version}.tar.gz

BuildRequires:  rust >= 1.70, cargo, systemd-rpm-macros
Requires:       systemd
Requires(post): systemd
# semanage: the file-context rules below (bin_t on the binaries), see %post
Requires(post): policycoreutils-python-utils
Requires(preun): systemd
Requires(postun): systemd

%description
Synthaea EDR Agent provides on-device detection using eBPF sensors,
ML-based anomaly detection, and response capabilities.

%prep
%setup -q

%build
# --exclude needs --workspace. Honour CARGO_TARGET_DIR (a small build host may keep
# its target directory elsewhere); %install reads the same variable.
cargo build --release --workspace --bins --exclude sensor-linux-ebpf

%install
# Binaries to bootstrap directory
T="${CARGO_TARGET_DIR:-target}/release"
install -D -m 0755 "$T/agent" %{buildroot}/var/lib/synthaea/bootstrap/agent
install -D -m 0755 "$T/watchdog" %{buildroot}/var/lib/synthaea/bootstrap/watchdog
install -D -m 0755 "$T/cli" %{buildroot}/var/lib/synthaea/bootstrap/cli

# systemd integration
install -D -m 0644 packaging/linux/systemd/synthaea-agent.service \
    %{buildroot}%{_unitdir}/synthaea-agent.service
%{_bindir}/synthaea-ctl
install -D -m 0644 packaging/linux/systemd/synthaea.sysusers \
    %{buildroot}%{_sysusersdir}/synthaea.conf
install -D -m 0644 packaging/linux/systemd/synthaea.tmpfiles \
    %{buildroot}%{_tmpfilesdir}/synthaea.conf

# State directories
install -d -m 0750 %{buildroot}/var/lib/synthaea/versions
install -d -m 0750 %{buildroot}/var/log/synthaea

# Config directory (placeholder)
install -d -m 0755 %{buildroot}/etc/synthaea

# CLI symlink, as the .deb postinst creates it. The unit cannot: it runs as the
# unprivileged synthaea user under ProtectSystem=strict, so /usr is read-only.
install -d -m 0755 %{buildroot}%{_bindir}
ln -s /var/lib/synthaea/current/cli %{buildroot}%{_bindir}/synthaea-ctl

%pre
%sysusers_create_compat packaging/linux/systemd/synthaea.sysusers

%post
# Create current symlink to bootstrap
if [ ! -e /var/lib/synthaea/current ]; then
    ln -s bootstrap /var/lib/synthaea/current
fi

# Enable and start service
%systemd_post synthaea-agent.service

# SELinux: the binaries live under /var/lib/synthaea, whose default type is
# var_lib_t, and init_t is denied execute/execute_no_trans/map on that type, so
# the service dies with status=203/EXEC on an Enforcing host. bin_t makes them
# executable (the service then runs as unconfined_service_t). The rule also covers
# the updater's versions/vN trees; files the updater writes still need a
# restorecon after staging (they inherit var_lib_t from the directory).
if command -v semanage >/dev/null 2>&1; then
    semanage fcontext -a -t bin_t '/var/lib/synthaea/bootstrap(/.*)?' 2>/dev/null || :
    semanage fcontext -a -t bin_t '/var/lib/synthaea/versions/[^/]+/.+' 2>/dev/null || :
fi
if command -v restorecon >/dev/null 2>&1; then
    restorecon -R /var/lib/synthaea /var/log/synthaea || :
fi

# Create runtime directories
systemd-tmpfiles --create synthaea.conf || :

%preun
%systemd_preun synthaea-agent.service

%postun
%systemd_postun_with_restart synthaea-agent.service
# Clean uninstall (not upgrade)
if [ $1 -eq 0 ]; then
    if command -v semanage >/dev/null 2>&1; then
        semanage fcontext -d '/var/lib/synthaea/bootstrap(/.*)?' 2>/dev/null || :
        semanage fcontext -d '/var/lib/synthaea/versions/[^/]+/.+' 2>/dev/null || :
    fi
    rm -rf /var/lib/synthaea /var/log/synthaea
    userdel synthaea 2>/dev/null || :
fi

%files
%license LICENSE
%doc README.md
/var/lib/synthaea/bootstrap/agent
/var/lib/synthaea/bootstrap/watchdog
/var/lib/synthaea/bootstrap/cli
%{_unitdir}/synthaea-agent.service
%{_sysusersdir}/synthaea.conf
%{_tmpfilesdir}/synthaea.conf
%dir %attr(0750,synthaea,synthaea) /var/lib/synthaea
%dir %attr(0750,synthaea,synthaea) /var/lib/synthaea/versions
%dir %attr(0750,synthaea,synthaea) /var/log/synthaea
%dir /etc/synthaea

