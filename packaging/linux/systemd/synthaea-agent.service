[Unit]
Description=Synthaea Endpoint Detection & Response
Documentation=https://docs.synthaea.io
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=synthaea
Group=synthaea

# Bootstrap setup: create symlinks and directories on first start (issue #36)
ExecStartPre=/bin/sh -c 'test -e /var/lib/synthaea/current || ln -s bootstrap /var/lib/synthaea/current'
ExecStartPre=/bin/sh -c 'test -d /var/lib/synthaea/versions || mkdir -p /var/lib/synthaea/versions'

# Use updater-managed current symlink, fallback to bootstrap
ExecStart=/var/lib/synthaea/current/watchdog run \
    --agent-bin /var/lib/synthaea/current/agent \
    --alerts /var/log/synthaea/alerts.ndjson

# Kill resistance: always restart
Restart=always
RestartSec=5s

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/synthaea /var/log/synthaea /run/synthaea

# Logging to systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=synthaea-watchdog

[Install]
WantedBy=multi-user.target
