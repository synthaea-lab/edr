# Database
DATABASE_URL="postgresql://synthaea:synthaea_dev@localhost:5432/synthaea"

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="dev_secret_change_in_production"
BETTER_AUTH_SECRET="dev_secret_change_in_production"

# Cron
CRON_SECRET="dev_cron_secret"

# Nginx Proxy Authentication (CRITICAL: change in production)
# Shared secret between nginx proxy and Next.js server to prevent header spoofing
NGINX_PROXY_SECRET="dev_nginx_secret_change_in_production"

# Node
NODE_ENV="development"

# Case narrative LLM (issue #50, ADR-0017)
# Any OpenAI-compatible chat-completions endpoint. Defaults below target a
# locally self-hosted Ollama instance - no external network call, no API key
# needed, per ADR-0001's self-hosting stance. Point at a different provider
# by overriding these, no code change required.
LLM_BASE_URL="http://localhost:11434/v1"
LLM_MODEL="llama3.1"
LLM_API_KEY="ollama"
LLM_PROVIDER_LABEL="self-hosted"
LLM_TIMEOUT_MS="30000"
