// Synthaea Control Plane - PostgreSQL Schema
// Tenant-first architecture with Row-Level Security

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tenancy foundation - organization = tenant
model Tenant {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  agents              Agent[]
  detections          Detection[]
  cases               Case[]
  fleetCases          FleetCase[]
  caseNarratives      CaseNarrative[]
  auditLogs           AuditLog[]           @relation("TenantAuditLogs")
  contentReleases     ContentRelease[]
  binaryReleases      BinaryRelease[]
  corpusVersions      CorpusVersion[]
  corpusSamples       CorpusSample[]
  prevalenceSightings PrevalenceSighting[]
  ingestStats         IngestStat[]
  commonSetSnapshot   CommonSetSnapshot?
  hunts               Hunt[]
  huntRuns            HuntRun[]
  decoyTokens         DecoyToken[]
  notificationChannels NotificationChannel[]
  notifications       Notification[]

  @@map("tenants")
}

// Agent enrollment and heartbeat tracking
model Agent {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  enrollmentId String   @unique @map("enrollment_id") // mTLS cert subject CN
  hostname     String?
  version      String?
  ring         String   @default("prod") // Canary ring: canary_0, canary_1, canary_2, prod
  lastSeen     DateTime @map("last_seen")
  createdAt    DateTime @default(now()) @map("created_at")
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  health      AgentHealth?
  decoyTokens DecoyToken[]

  @@index([tenantId, lastSeen])
  @@index([tenantId, ring])
  @@index([tenantId, ring, lastSeen])
  @@index([enrollmentId])
  @@map("agents")
}

// Latest health beacon per agent (issue #83). One row per agent, overwritten by
// each beacon: bounded by fleet size, not by uptime. A time series (loss-counter
// rates, sensor flapping) is a later slice and needs its own retention.
model AgentHealth {
  agentId                String    @id @map("agent_id")
  tenantId               String    @map("tenant_id")
  beaconAt               DateTime  @map("beacon_at") // the agent's own clock
  receivedAt             DateTime  @map("received_at")
  agentVersion           String    @map("agent_version")
  spoolBytes             BigInt    @map("spool_bytes")
  spoolDropped           BigInt    @map("spool_dropped")
  enrichDropped          BigInt    @map("enrich_dropped")
  // When the control plane last saw a loss counter (spool or enrichment queue) rise between two
  // beacons, by its own clock (issue #83). The counters are cumulative since the agent started and
  // only the latest beacon is kept, so "recent loss" has to be remembered, not derived.
  lossObservedAt         DateTime? @map("loss_observed_at")
  // The common-set rarity evidence counters (ADR-0020, issue #76); zero for an agent that
  // predates them.
  rarityApplied          BigInt    @default(0) @map("rarity_applied")
  rarityWithheld         BigInt    @default(0) @map("rarity_withheld")
  rarityUnapplied        BigInt    @default(0) @map("rarity_unapplied")
  // Self-protection and cache counters (issue #863); zero for an agent that predates them.
  // Cumulative since the agent started, except `watchdogRestarts`, which is the watchdog's own
  // count since it started. Shown on the fleet page; none of them makes a host degraded.
  watchdogRestarts       BigInt    @default(0) @map("watchdog_restarts")
  tamperEvents           BigInt    @default(0) @map("tamper_events")
  parentImageEvictedLive BigInt    @default(0) @map("parent_image_evicted_live")
  parentImageEvictedDead BigInt    @default(0) @map("parent_image_evicted_dead")
  // On-device IOC engine (#60); zero for an agent that predates them. `iocIndicators` is a gauge
  // (indicators in force), the other two are cumulative since the agent started.
  iocIndicators          BigInt    @default(0) @map("ioc_indicators")
  iocFindings            BigInt    @default(0) @map("ioc_findings")
  iocCooledDown          BigInt    @default(0) @map("ioc_cooled_down")
  sensors                Json // [{ name, pulse_count, silent }]

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("agent_health")
}

// Decoy credentials an agent planted (issue #81). Only the SHA-256 of a token is stored,
// never the token: the control plane can recognise a decoy when it is presented, and
// cannot hand one out. Append-only on purpose: an agent that removes its decoys does not
// make an old copy of the file safe to use. A hash belongs to the agent that registered it
// first (unique), so another agent cannot claim it.
model DecoyToken {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  agentId          String   @map("agent_id")
  tokenSha256      String   @map("token_sha256")
  createdAt        DateTime @default(now()) @map("created_at")
  lastRegisteredAt DateTime @default(now()) @map("last_registered_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // NoAction: deleting an agent that holds decoy hashes fails instead of silently disarming
  // them (an attacker may hold an old copy); deleting the tenant still removes both.
  agent  Agent  @relation(fields: [agentId], references: [id], onDelete: NoAction)

  // One row per (agent, hash): an agent cannot take a hash another holds, and a presented
  // token alarms for every holder.
  @@unique([agentId, tokenSha256])
  @@index([tokenSha256])
  @@index([tenantId])
  @@index([agentId])
  @@map("decoy_tokens")
}

// Detection storage - events that triggered rules
model Detection {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  agentId           String   @map("agent_id")
  // Grouped into a Case by the cron/group-detections sweep (issue #50); null
  // until grouped, so "caseId: null" is the query for "ungrouped evidence".
  caseId            String?  @map("case_id")
  // The fleet-level case this detection was joined into across hosts by the
  // cron/join-fleet-cases sweep (issue #62); independent of `caseId`, which is
  // one host's grouping. Null when it joined nothing.
  fleetCaseId       String?  @map("fleet_case_id")
  timestamp         DateTime
  technique         String // MITRE ATT&CK technique (e.g., T1059.001)
  severity          String // low/medium/high/critical
  // Optional for older agents. A durable uploader reuses the same key across
  // retries; uniqueness is scoped to its mTLS-authenticated agent.
  ingestId          String?  @map("ingest_id")
  ingestPayloadHash String?  @map("ingest_payload_hash")

  // Event data (JSON) - normalized schema::Event
  event Json
  meta  Json

  createdAt DateTime @default(now()) @map("created_at")
  // Bumped whenever caseId (or any other field) changes, notably by the
  // cron/group-detections sweep — the staleness check on a case narrative
  // compares against this, not createdAt, since a detection can be grouped
  // into a case well after it was ingested (see GET /api/cases/[id]).
  //
  // @default(now()) alongside @updatedAt (review, Jihair54/Sollykhan): without
  // it, adding this NOT NULL column to a table that already has rows fails —
  // Postgres has no value to backfill existing rows with. The default only
  // matters for that one backfill; every write after this migration still
  // goes through @updatedAt's own bump-on-write behavior.
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // SetNull, not Cascade: deleting a Case must not delete the underlying
  // evidence it was built from.
  case   Case?  @relation(fields: [caseId], references: [id], onDelete: SetNull)
  fleetCase FleetCase? @relation(fields: [fleetCaseId], references: [id], onDelete: SetNull)

  @@unique([agentId, ingestId])
  @@index([tenantId, timestamp])
  @@index([agentId, timestamp])
  @@index([technique])
  @@index([caseId])
  @@index([fleetCaseId])
  @@map("detections")
}

// Case management - analyst triage workflow
model Case {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  title       String
  description String?
  severity    String // low/medium/high/critical
  status      String // open/investigating/resolved/false_positive
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  detections Detection[]
  narratives CaseNarrative[]

  @@index([tenantId, status, createdAt])
  @@index([severity])
  @@map("cases")
}

// Fleet case (issue #62, box 1): detections of two or more agents joined by a
// shared entity (a file hash or an identity, `lib/fleet-case.ts`). Written only
// by cron/join-fleet-cases; rebuildable from the detections, which stay the
// evidence. `severity` is the highest of its detections and never goes down.
model FleetCase {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  severity   String // low/medium/high/critical
  status     String   @default("open") // open/investigating/resolved/false_positive
  agentCount Int      @map("agent_count")
  firstAt    DateTime @map("first_at")
  lastAt     DateTime @map("last_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entities   FleetCaseEntity[]
  detections Detection[]

  @@index([tenantId, status, createdAt])
  @@map("fleet_cases")
}

// One entity a fleet case joined on. Unique per tenant: an entity belongs to
// one fleet case, so a later sighting of it grows that case instead of opening
// a second one, and a detection that bridges two cases merges them.
model FleetCaseEntity {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  fleetCaseId String   @map("fleet_case_id")
  kind        String // sha256 | identity
  key         String
  createdAt   DateTime @default(now()) @map("created_at")

  fleetCase FleetCase @relation(fields: [fleetCaseId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kind, key])
  @@index([fleetCaseId])
  @@map("fleet_case_entities")
}

// Case narrative - one row per LLM-generated narration of a case's evidence
// graph (issue #50). Append-only, not a JSON column on Case: keeps generation
// history/provenance and avoids coupling regeneration to unrelated Case
// writes (status/severity triage edits).
model CaseNarrative {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  caseId        String   @map("case_id")
  narrative     String
  // [{ detectionId, claim }] - every detectionId is verified to reference a
  // Detection actually on this case before the row is written (see
  // assistant/llm-client.ts); a hallucinated citation is dropped, not stored.
  citations     Json
  model         String // e.g. "llama3.1"
  provider      String // operator-facing label, e.g. "self-hosted"
  promptVersion Int      @map("prompt_version")
  generatedBy   String   @map("generated_by") // "system:cron" | "user:<userId>"
  generatedAt   DateTime @default(now()) @map("generated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, generatedAt])
  @@index([tenantId, generatedAt])
  @@map("case_narratives")
}

// Audit log - all control plane actions
model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  action    String // enrollment.create, case.update, policy.deploy, etc.
  resource  String // cases/123, agents/456
  details   Json?
  timestamp DateTime @default(now())

  tenant Tenant @relation("TenantAuditLogs", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, timestamp])
  @@index([userId, timestamp])
  @@index([action])
  @@map("audit_logs")
}

// Content release - tracks content manifest versions per ring
model ContentRelease {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  ring           String // canary_0, canary_1, canary_2, prod
  releaseVersion Int      @map("release_version") // Monotone counter
  manifestUrl    String   @map("manifest_url") // Storage URL for manifest JSON
  manifestSha256 String   @map("manifest_sha256") // SHA-256 of manifest file
  status         String   @default("active") // active, halted, rolled_back
  releasedAt     DateTime @map("released_at")
  createdAt      DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, ring, releaseVersion])
  @@index([tenantId, ring, status])
  @@index([tenantId, ring, releaseVersion])
  @@map("content_releases")
}

// Binary release - a signed agent/watchdog/cli release offered to a ring's
// agents (ADR-0015, issue #30's update trigger). The row points at the signed
// `ReleaseManifest` JSON (signed offline: the server never holds the private
// key); artifacts live at `storage/releases/v<releaseVersion>/<path>`.
model BinaryRelease {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  ring           String // canary_0, canary_1, canary_2, prod
  releaseVersion Int      @map("release_version") // Monotone per (tenant, ring); equals the manifest's own release_version
  manifestUrl    String   @map("manifest_url") // Storage URL for the signed manifest JSON
  manifestSha256 String   @map("manifest_sha256") // SHA-256 of the manifest file
  status         String   @default("active") // active, halted
  releasedAt     DateTime @map("released_at")
  createdAt      DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, ring, releaseVersion])
  @@index([tenantId, ring, status])
  @@map("binary_releases")
}

// Corpus version - versioned snapshot of site-specific benign corpus
model CorpusVersion {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  version         Int // Monotone version counter (per tenant)
  sampleCount     Int       @map("sample_count") // Number of samples in this version
  exportUrl       String?   @map("export_url") // JSONL export URL (for ML pipeline)
  exportSha256    String?   @map("export_sha256") // SHA-256 of JSONL export
  status          String    @default("collecting") // collecting, finalized, archived
  collectionStart DateTime  @map("collection_start") // Start of collection period
  collectionEnd   DateTime? @map("collection_end") // End of collection period (when finalized)
  createdAt       DateTime  @default(now()) @map("created_at")

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  samples CorpusSample[]

  @@unique([tenantId, version])
  @@index([tenantId, status])
  @@index([tenantId, version])
  @@map("corpus_versions")
}

// Corpus sample - individual benign telemetry sample for T3 curation
model CorpusSample {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  corpusVersionId String   @map("corpus_version_id")
  agentId         String   @map("agent_id") // Source agent for provenance
  timestamp       DateTime // Event timestamp
  eventType       String   @map("event_type") // exec, file_open, connect, etc.

  // Event data (JSON) - normalized schema::Event
  event Json

  createdAt DateTime @default(now()) @map("created_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  corpusVersion CorpusVersion @relation(fields: [corpusVersionId], references: [id], onDelete: Cascade)

  @@index([tenantId, corpusVersionId])
  @@index([agentId, timestamp])
  @@index([eventType])
  @@map("corpus_samples")
}

// Fleet prevalence (issue #76, Layer 5): one row per (tenant, kind, key, agent).
// "Seen on N hosts, first <date>" is derived by aggregating the rows for a key,
// so the host count is exact without a separate distinct-set. Per-tenant only;
// nothing here is ever joined across tenants.
model PrevalenceSighting {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  agentId   String   @map("agent_id")
  // sha256 | image_path | transition | domain (lib/prevalence.ts)
  kind      String
  key       String
  firstSeen DateTime @map("first_seen")
  lastSeen  DateTime @map("last_seen")
  count     Int      @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kind, key, agentId])
  @@index([tenantId, kind, key])
  @@map("prevalence_sightings")
}

// Ingest health (issue #899, lib/ingest-stats.ts): what /api/ingest/* took, skipped and refused
// per agent, kind (events | detection | beacon) and hour. Best-effort counters; hourly rows are
// pruned by the prune-prevalence cron.
model IngestStat {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  agentId        String    @map("agent_id")
  kind           String
  bucket         DateTime
  received       Int       @default(0)
  accepted       Int       @default(0)
  skipped        Int       @default(0)
  refused4xx     Int       @default(0) @map("refused_4xx")
  refused5xx     Int       @default(0) @map("refused_5xx")
  // Event lag (ingest time minus event time), ms. BigInt: a reconnecting agent uploads events
  // weeks old. Sum and count give the mean; a bucket row cannot give a median.
  lagSumMs       BigInt    @default(0) @map("lag_sum_ms")
  lagCount       Int       @default(0) @map("lag_count")
  lagMaxMs       BigInt?   @map("lag_max_ms")
  lastAcceptedAt DateTime? @map("last_accepted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, agentId, kind, bucket])
  @@index([tenantId, bucket])
  @@map("ingest_stats")
}

// Saved hunt (issue #61): a versioned, structured query over the tenant's
// detections, with an owner and an optional schedule. Not raw SQL: `query` is
// the `HuntQuery` of lib/hunt.ts, validated on every write and compiled to
// parameterized SQL, so a hunt cannot name a table or reach another tenant.
// Result history is HuntRun; a hunt that keeps matching is what detection
// content graduates from (#618). See ADR-0025.
model Hunt {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  name            String
  description     String?
  // Session user that created it; kept as a plain id (the auth tables are not
  // in this schema).
  ownerId         String   @map("owner_id")
  query           Json
  // Starts at 1 and goes up on every change to `query`, so a run says which
  // query it ran (HuntRun.queryVersion) and an edit never rewrites history.
  version         Int      @default(1)
  // Minutes between scheduled runs; null = manual only.
  scheduleMinutes Int?     @map("schedule_minutes")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs   HuntRun[]

  @@index([tenantId, createdAt])
  @@index([active, scheduleMinutes])
  @@map("hunts")
}

// One execution of a hunt. Append-only; the cron keeps the newest
// HUNT_RUNS_KEPT per hunt, so history is bounded.
model HuntRun {
  id                 String    @id @default(uuid())
  huntId             String    @map("hunt_id")
  tenantId           String    @map("tenant_id")
  startedAt          DateTime  @default(now()) @map("started_at")
  finishedAt         DateTime? @map("finished_at")
  // The query version and a copy of the query as it ran.
  queryVersion       Int       @map("query_version")
  query              Json
  // Detections matching the query in its window.
  matchCount         Int       @default(0) @map("match_count")
  // Of those, ingested since the hunt's previous run started (all of them on
  // the first run): what a "notify on new matches" would key on.
  newMatchCount      Int       @default(0) @map("new_match_count")
  // Newest matching detection ids, at most HUNT_SAMPLE_SIZE.
  sampleDetectionIds Json      @map("sample_detection_ids")
  // Set when the run failed (e.g. the statement timeout); counts stay 0.
  error              String?
  trigger            String // manual | schedule

  hunt   Hunt   @relation(fields: [huntId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([huntId, startedAt])
  @@map("hunt_runs")
}

// --- Console authentication (better-auth, ADR-0003, issue #810) ---------------------------
//
// The tables better-auth reads and writes through `prismaAdapter` (`lib/auth.ts`), with its
// own model and field names (`user`, `session`, ...), so `prisma db push` creates them with
// the rest of the schema. The fields are the ones `getAuthTables` reports for better-auth 1.7
// with the organization plugin; a better-auth upgrade can add some, so re-check them then
// (`tests/integration/console-auth.test.ts` fails if a required one is missing).
//
// `Organization` is better-auth's tenancy primitive and `Tenant` above is this app's: the
// middleware uses a session's `activeOrganizationId` as the tenant id, so an organization's
// id must equal its tenant's id. Nothing creates the pair yet (admin-only tenant creation is
// configured, not built).

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  sessions    Session[]
  accounts    Account[]
  members     Member[]
  invitations Invitation[]

  @@map("auth_user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime @map("expires_at")
  token                String   @unique
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at")
  ipAddress            String?  @map("ip_address")
  userAgent            String?  @map("user_agent")
  userId               String   @map("user_id")
  activeOrganizationId String?  @map("active_organization_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("auth_verification")
}

model Organization {
  id        String   @id
  name      String
  slug      String   @unique
  logo      String?
  createdAt DateTime @default(now()) @map("created_at")
  metadata  String?

  members     Member[]
  invitations Invitation[]

  @@map("auth_organization")
}

model Member {
  id             String   @id
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  role           String
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@map("auth_member")
}

model Invitation {
  id             String   @id
  organizationId String   @map("organization_id")
  email          String
  role           String?
  status         String
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")
  inviterId      String   @map("inviter_id")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("auth_invitation")
}

// Operator notification channel (ADR-0036, #863): a signed webhook a tenant admin registered.
// The signing secret is sealed (AES-256-GCM, channel id as AAD); it is never returned.
model NotificationChannel {
  id                  String    @id @default(uuid())
  tenantId            String    @map("tenant_id")
  kind                String    @default("webhook")
  // The URL is sealed like the secret (its path is often a bearer credential); `host` is the
  // only part shown anywhere (console, audit rows, logs).
  host                String
  urlKeyId            String    @map("url_key_id")
  urlSealed           String    @map("url_sealed")
  secretKeyId         String    @map("secret_key_id")
  secretSealed        String    @map("secret_sealed")
  // For 24 hours after a rotation the previous secret also signs (two v1= values).
  prevSecretKeyId     String?   @map("prev_secret_key_id")
  prevSecretSealed    String?   @map("prev_secret_sealed")
  prevSecretUntil     DateTime? @map("prev_secret_until")
  events              String[]  // subscribed event names; empty means none
  huntIds             String[]  @map("hunt_ids") // hunts whose hunt.new_matches this channel receives
  status              String    @default("active") // active | paused | disabled
  cooldownSeconds     Int       @default(1800) @map("cooldown_seconds")
  lastStatusCode      Int?      @map("last_status_code")
  lastError           String?   @map("last_error")
  lastDeliveredAt     DateTime? @map("last_delivered_at")
  // Set when an admin re-enables a paused channel: "five consecutive failed rows" counts from here.
  pauseCountFrom      DateTime? @map("pause_count_from")
  createdBy           String    @map("created_by")
  createdAt           DateTime  @default(now()) @map("created_at")

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  notifications Notification[]
  states        NotificationState[]

  @@index([tenantId])
  @@map("notification_channels")
}

// The last state a channel was told about a subject (a host): per channel, not per agent, so a
// channel in cooldown does not make another one miss a transition (ADR-0036 point 2). It
// advances only when a row is enqueued for that channel.
model NotificationState {
  channelId String   @map("channel_id")
  subject   String // the agent id
  state     String // healthy | degraded | silent
  updatedAt DateTime @updatedAt @map("updated_at")

  channel NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([channelId, subject])
  @@map("notification_states")
}

// The outbox: one row per (channel, event occurrence). `id` is the event id the receiver
// de-duplicates on. Delivery is at least once.
model Notification {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  channelId     String    @map("channel_id")
  event         String
  subject       String // agent id or hunt id
  seq           Int // per (channel, subject), so a receiver can check order
  payload       Json
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
  lockedUntil   DateTime? @map("locked_until")
  // Which claim holds the row: every write of a delivery's outcome names it, so a tick whose
  // lease expired cannot overwrite what the tick that took the row over recorded.
  leaseId       String?   @map("lease_id")
  lastAttemptAt DateTime? @map("last_attempt_at")
  deliveredAt   DateTime? @map("delivered_at")
  failedAt      DateTime? @map("failed_at")
  lastStatus    Int?      @map("last_status")
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at")

  tenant  Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, subject, seq])
  @@index([deliveredAt, failedAt, nextAttemptAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, lastAttemptAt])
  @@map("notifications")
}

// The tenant's latest common-set snapshot (ADR-0033, #76 box 2): the artifact bytes and the
// signed manifest that names them. One row per tenant, replaced by each build; the agent fetches
// both through /api/snapshot/*. The builder's guards compare a new build with this row.
model CommonSetSnapshot {
  id         String   @id @default(uuid())
  tenantId   String   @unique @map("tenant_id")
  builtAt    DateTime @map("built_at")
  hostsCovered Int     @map("hosts_covered")
  minHosts   Int      @map("min_hosts")
  entryCount Int      @map("entry_count")
  sha256     String
  size       Int
  // The SnapshotManifest as signed (lib/snapshot-manifest.ts).
  manifest   Json
  artifact   Bytes
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("common_set_snapshots")
}
